<Window x:Class="GameHub.Modules.SoundSwitch.SoundSwitchSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundSwitch · 设备切换" Height="680" Width="580"
        MinHeight="520" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <ControlTemplate x:Key="RoundedButton" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}" BorderThickness="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4A90D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E3E9F0"/>
            <Setter Property="Foreground" Value="#33475B"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#22303F"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8896A6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DeviceItem" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="设备切换" FontSize="20" FontWeight="Bold" Foreground="#22303F"/>
            <TextBlock Text="勾选设备设为热键切换范围，热键将在勾选设备间循环切换；点击列表项可切换默认设备"
                       Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
            <StackPanel>

                <!-- 输出设备 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="输出设备（播放）" Style="{StaticResource SectionTitle}"/>
                        
                        <!-- 设备列表带复选框 -->
                        <ListBox x:Name="PlaybackList" Height="140" Margin="0,0,0,8"
                                 ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource DeviceItem}" 
                                              Content="{Binding Device.Name}" 
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Click="PlaybackDevice_Click"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 热键说明 -->
                        <TextBlock Text="勾选多个设备，热键将在这些设备间循环切换" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                                    Click="RefreshDevices_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 输入设备 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="输入设备（录音）" Style="{StaticResource SectionTitle}"/>
                        
                        <!-- 设备列表带复选框 -->
                        <ListBox x:Name="RecordingList" Height="140" Margin="0,0,0,8"
                                 ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource DeviceItem}" 
                                              Content="{Binding Device.Name}" 
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Click="RecordingDevice_Click"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 热键说明 -->
                        <TextBlock Text="勾选多个设备，热键将在这些设备间循环切换" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                                    Click="RefreshDevices_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 热键 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="热键切换" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="PlaybackHotkeyEnabled" Content="启用输出设备切换热键"
                                  FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="PlaybackHotkeyBox" Height="28" FontSize="12"
                                 IsReadOnly="True" VerticalContentAlignment="Center"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                        <CheckBox x:Name="RecordingHotkeyEnabled" Content="启用输入设备切换热键"
                                  FontSize="12" Margin="0,14,0,6"/>
                        <TextBox x:Name="RecordingHotkeyBox" Height="28" FontSize="12"
                                 IsReadOnly="True" VerticalContentAlignment="Center"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="点击输入框后直接按下组合键即可录制。热键会在工具箱运行时全局生效（可最小化）。"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存并应用" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
