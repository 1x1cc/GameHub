<widgets:GlassBoardWidgetWindow x:Class="GameHub.Modules.GlassBoard.GlassBoardNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:GameHub.Modules.GlassBoard"
        Title="GlassBoard 备忘录" Width="320" Height="286">
    <widgets:GlassBoardWidgetWindow.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#55FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#77FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#7FB4E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="26"/>
        </Style>
    </widgets:GlassBoardWidgetWindow.Resources>

    <!-- 外观与其余悬浮窗统一：圆角 18 / 底色 #B3181A20 / 描边 #24D5E3FF / 投影 Blur 20 -->
    <Border x:Name="Shell" CornerRadius="18" Padding="12" Background="#B3181A20"
            BorderBrush="#24D5E3FF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 拖动条：只有这条横条负责拖动，避免抢走输入框/按钮的点击 -->
            <Border Grid.Row="0" Height="18" Background="Transparent" Cursor="SizeAll"
                    MouseLeftButtonDown="DragStrip_MouseLeftButtonDown">
                <TextBlock Text="备忘录" FontSize="11" Foreground="#8FA0B8" VerticalAlignment="Center"/>
            </Border>

            <!-- 笔记下拉 + 新建 / 删除 -->
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="NotePicker" Grid.Column="0" DisplayMemberPath="DisplayTitle"
                          SelectionChanged="NotePicker_SelectionChanged"/>

                <Button Grid.Column="1" Content="新建" Width="52" Height="26" Margin="6,0,0,0"
                        Padding="0" Click="Add_Click"/>
                <Button Grid.Column="2" Content="删除" Width="52" Height="26" Margin="6,0,0,0"
                        Padding="0" Click="Delete_Click"/>
            </Grid>

            <!-- 标题（说明书：最多约 120 个字符） -->
            <TextBox x:Name="TitleBox" Grid.Row="2" Height="28" Margin="0,8,0,0"
                     FontSize="13" MaxLength="120" TextChanged="TitleBox_TextChanged"/>

            <!-- 正文 -->
            <TextBox x:Name="BodyBox" Grid.Row="3" Margin="0,8,0,0" FontSize="13"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" TextChanged="BodyBox_TextChanged"/>

            <!-- 清单 / 导出 + 保存状态 -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="清单" Width="52" Height="26" Padding="0"
                        Click="Checklist_Click"/>
                <Button Grid.Column="1" Content="导出" Width="52" Height="26" Margin="6,0,0,0"
                        Padding="0" Click="Export_Click"/>

                <TextBlock x:Name="StatusText" Grid.Column="2" Text="已保存" FontSize="11"
                           Foreground="#8FA0B8" VerticalAlignment="Center"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>
    </Border>
</widgets:GlassBoardWidgetWindow>
