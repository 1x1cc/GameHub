<Window x:Class="GameHub.Modules.GlassBoard.GlassBoardControlOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassBoard 控制中心"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" SizeToContent="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <!-- 外层留 14 的余量给投影，里面那个圆就是“小球”本体
         （对应原版 ControlOrbWindow 的 Root.Margin = 14）。
         颜色、圆角、字形全部在代码里按配置赋值，XAML 里不写死。 -->
    <Grid x:Name="HitArea" Background="Transparent" Margin="14">
        <Border x:Name="Shell" CornerRadius="27" BorderThickness="1">
            <Border.Background>
                <SolidColorBrush Color="#CC181A20"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <ContentPresenter x:Name="GlyphHost"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsHitTestVisible="False"/>
        </Border>
    </Grid>
</Window>
