<Window x:Class="GameHub.Modules.GlassBoard.Dock.GlassBoardDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassBoard Dock"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" SizeToContent="Manual">
    <Grid>
        <!-- 玻璃底板：圆角、描边、投影，对应原版 Surface -->
        <Border x:Name="Surface" CornerRadius="28" BorderThickness="1" Margin="14,0,14,0">
            <Border.Background>
                <SolidColorBrush Color="#B3181A20"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <!-- 图标排布区：Margin 会在 Refresh 里按 HoverPadding 动态设置 -->
            <StackPanel x:Name="Items" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,16,0"/>
        </Border>

        <!-- 拖动把手：拖它移动整条 Dock，对应原版 moveGrip -->
        <Border x:Name="MoveGrip" Width="42" Height="6" CornerRadius="3"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,7,0,0" Background="#66FFFFFF" Cursor="SizeAll"
                ToolTip="拖动这里移动 Dock，位置会记住"
                MouseLeftButtonDown="MoveGrip_MouseLeftButtonDown"/>
    </Grid>
</Window>
