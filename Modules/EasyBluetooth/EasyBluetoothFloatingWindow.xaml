<Window x:Class="GameHub.Modules.EasyBluetooth.EasyBluetoothFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyBluetooth 悬浮窗"
        Width="268" SizeToContent="Height" MaxHeight="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        WindowStartupLocation="Manual" Topmost="True"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>        <!-- 圆角电量条：自定义模板必须提供 PART_Track / PART_Indicator，
             ProgressBar 才能按百分比算出填充宽度。 -->
        <Style x:Key="BatteryBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#33FFFFFF" CornerRadius="3">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        CornerRadius="3" Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDE6F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 整块面板都可拖动（锁定时不响应） -->
    <Border x:Name="RootBorder" CornerRadius="10"
            Background="#E61B2231" BorderBrush="#3DFFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseRightButtonUp="Root_MouseRightButtonUp">
        <StackPanel Margin="10,8,10,8">

            <!-- 标题栏 -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/Icons/easybluetooth.png"
                           Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="无线设备电量" Foreground="#EEF4FF" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LockHint" Text="🔒" Foreground="#FFC46B" FontSize="11"
                               Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="⟳" Style="{StaticResource IconButton}" ToolTip="立即刷新"
                            Click="Refresh_Click"/>
                    <Button x:Name="LockButton" Content="🔓" Style="{StaticResource IconButton}"
                            ToolTip="锁定后不能拖动悬浮窗" Click="Lock_Click"/>
                    <Button Content="✕" Style="{StaticResource IconButton}" ToolTip="关闭悬浮窗"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- 设备列表 -->
            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3,0,3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                       Foreground="#E6EDF7" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PercentText}"
                                       Foreground="{Binding BarBrush}" FontSize="11"
                                       FontWeight="SemiBold"/>

                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0"
                                         Style="{StaticResource BatteryBarStyle}"
                                         Foreground="{Binding BarBrush}"
                                         Value="{Binding Percent}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyHint" Text="未发现设备" Foreground="#8C9AB0" FontSize="11"
                       Margin="0,4,0,2" Visibility="Collapsed"/>

            <TextBlock x:Name="FooterText" Text="" Foreground="#7E8CA3" FontSize="10"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
