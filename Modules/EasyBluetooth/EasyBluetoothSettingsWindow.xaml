<Window x:Class="GameHub.Modules.EasyBluetooth.EasyBluetoothSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameHub.Controls"
        Title="EasyBluetooth · 无线设备电量" Height="660" Width="600"
        MinHeight="480" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <ResourceDictionary>
            <!-- 主题由 App.xaml 在应用级合并（Themes/PaviseDark.xaml）；此处不再重复合并，
                 否则会复制第二份画刷实例，运行时换肤时本窗口不会被更新。 -->

            <ControlTemplate x:Key="RoundedButton" TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                        Padding="{TemplateBinding Padding}" BorderThickness="0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="RowCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
            </Style>

            <!-- 行内标签：深色主题下用 Dim 色，保证可读 -->
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            </Style>

            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="无线设备电量" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource FgBrush}"/>
                <Button Content="?" Style="{StaticResource HelpButton}" Margin="8,0,0,4"
                        VerticalAlignment="Bottom"
                        controls:HelpBubble.Text="显示本机蓝牙设备与 2.4G 无线外设的电量。电量来源：蓝牙 GATT 电池服务 / Windows 电源接口 / 设备属性（与系统“蓝牙和其他设备”中的读数一致）。"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="本机蓝牙与 2.4G 无线外设的电量。"/>
        </StackPanel>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 设备列表 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="设备列表" Style="{StaticResource SectionTitle}"/>

                        <ListBox x:Name="DeviceList" PreviewMouseWheel="List_PreviewMouseWheel" Height="190"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="立即刷新" Style="{StaticResource PrimaryButton}"
                                    Click="Refresh_Click"/>
                            <CheckBox x:Name="ListOnlyConnected" Content="只显示已连接的设备"
                                      Style="{StaticResource RowCheckBox}" Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Click="ListOnlyConnected_Changed"/>
                            <Button Content="打开系统蓝牙设置" Style="{StaticResource SecondaryButton}"
                                    Margin="12,0,0,0" Click="OpenBluetoothSettings_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="正在检测…"/>
                    </StackPanel>
                </Border>

                <!-- 电量刷新 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="电量刷新" Style="{StaticResource SectionTitle}"/>
                            <Button Content="?" Style="{StaticResource HelpButton}" Margin="6,0,0,10"
                                    controls:HelpBubble.Text="一次刷新只是设备枚举与属性读取，开销极低；实测 30 秒与 30 分钟的 CPU 占用几乎没有差别（空闲时均为 0%），因此默认 30 秒，保证电量变化能及时反映。"/>
                        </StackPanel>

                        <CheckBox x:Name="AutoRefreshEnabled" Content="定时自动刷新电量"
                                  Style="{StaticResource RowCheckBox}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="刷新间隔" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="RefreshIntervalBox" Width="130" Margin="10,0,0,0"
                                      FontSize="12" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="30 秒（推荐）" Tag="30"/>
                                <ComboBoxItem Content="1 分钟" Tag="60"/>
                                <ComboBoxItem Content="2 分钟" Tag="120"/>
                                <ComboBoxItem Content="5 分钟" Tag="300"/>
                                <ComboBoxItem Content="15 分钟" Tag="900"/>
                                <ComboBoxItem Content="30 分钟" Tag="1800"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="刷新开销极低，默认 30 秒（点右侧 ? 看依据）。"/>
                    </StackPanel>
                </Border>

                <!-- 低电量通知 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="低电量通知" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="LowBatteryNotifyEnabled" Content="电量低于阈值时弹通知"
                                  Style="{StaticResource RowCheckBox}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="低电量阈值" Style="{StaticResource RowLabel}"/>
                            <TextBox x:Name="LowBatteryThresholdBox" Width="60" Height="26" Margin="10,0,0,0"
                                     FontSize="12" VerticalContentAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="%" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DimBrush}"/>

                            <TextBlock Text="重复提醒间隔" FontSize="12" Margin="20,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}"/>
                            <ComboBox x:Name="LowBatteryRepeatBox" Width="100" Margin="10,0,0,0"
                                      FontSize="12" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="5 分钟" Tag="5"/>
                                <ComboBoxItem Content="15 分钟" Tag="15"/>
                                <ComboBoxItem Content="30 分钟" Tag="30"/>
                                <ComboBoxItem Content="60 分钟" Tag="60"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="只对“已连接”的设备提醒；同一台设备在重复提醒间隔内不会反复打扰。"/>
                    </StackPanel>
                </Border>

                <!-- 悬浮窗 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="悬浮窗" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="FloatingEnabled" Content="显示悬浮窗（常驻显示设备电量）"
                                  Style="{StaticResource RowCheckBox}"/>
                        <CheckBox x:Name="FloatingLocked" Content="锁定移动（锁定后不能用鼠标拖动）"
                                  Style="{StaticResource RowCheckBox}"/>
                        <CheckBox x:Name="FloatingTopmost" Content="始终置顶"
                                  Style="{StaticResource RowCheckBox}"/>
                        <CheckBox x:Name="FloatingClickThrough" Content="鼠标穿透（不挡游戏操作，右键菜单将不可用）"
                                  Style="{StaticResource RowCheckBox}"/>
                        <CheckBox x:Name="FloatingOnlyConnected" Content="只显示已连接的设备"
                                  Style="{StaticResource RowCheckBox}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="不透明度" Style="{StaticResource RowLabel}"/>
                            <Slider x:Name="FloatingOpacity" Width="180" Margin="10,0,0,0"
                                    Minimum="0.3" Maximum="1.0" Value="0.92"
                                    VerticalAlignment="Center"
                                    ValueChanged="FloatingOpacity_ValueChanged"/>
                            <TextBlock x:Name="FloatingOpacityText" Text="92%" FontSize="12"
                                       Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="预览/切换悬浮窗" Style="{StaticResource SecondaryButton}"
                                    Click="ToggleFloating_Click"/>
                            <Button Content="恢复默认位置" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="ResetFloatingPosition_Click"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="提示：锁定移动与鼠标穿透都是为了防止在游戏中误拖/误点；开启鼠标穿透后需要在本窗口里修改设置。"/>
                    </StackPanel>
                </Border>

                <!-- 音频卡顿提示 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="音频卡顿提示" Style="{StaticResource SectionTitle}"/>
                            <Button Content="?" Style="{StaticResource HelpButton}" Margin="6,0,0,10"
                                    controls:HelpBubble.Text="若蓝牙耳机的声音偶尔卡顿、断续或带电流声，多半是手机同时开着 Wi-Fi（2.4G）与蓝牙共用同一频段、互相干扰造成的：在手机上关闭 Wi-Fi、或改用 5G Wi-Fi 后通常就会消失（这属于无线频段干扰，电脑端无法代为修复）。另外两种常见情况：耳机与手机相隔太远、或同时连着两台设备（双连接）时也容易卡顿；靠近一些、或断开其中一台即可改善。"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}"
                                   Text="耳机声音卡顿 / 断续的常见原因与处理（点右侧 ? 看细节）。"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
