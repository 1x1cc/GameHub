<Window x:Class="GameHub.Modules.Dronesee.DroneseeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameHub.Controls"
        Title="Dronesee · 游戏录制与重放" Height="780" Width="680"
        MinHeight="600" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <ResourceDictionary>
            <!-- 主题由 App.xaml 在应用级合并（Themes/PaviseDark.xaml）；此处不再重复合并，
                 否则会复制第二份画刷实例，运行时换肤时本窗口不会被更新。 -->

            <ControlTemplate x:Key="RoundedButton" TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                        Padding="{TemplateBinding Padding}" BorderThickness="0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="RowCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
            </Style>

            <!-- 行内标签：固定 70 宽，保证各行左侧对齐 -->
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Width" Value="70"/>
                <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            </Style>

            <Style x:Key="UnitLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
            </Style>

            <!-- 滑动开关：录制 / 即时重放的功能总开关 -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="track" Width="46" Height="24" CornerRadius="12"
                                        Background="{DynamicResource TrackOffBrush}" VerticalAlignment="Center">
                                    <Border x:Name="thumb" Width="20" Height="20" CornerRadius="10"
                                            Background="#FFFFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 这三条是窗口级隐式样式：必须 BasedOn 主题的同名隐式样式，
                 否则会整体顶掉主题的深色底 / 浅色文字（Dronesee 页面的黑字问题就在这里）。 -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Dronesee" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource FgBrush}"/>
                <Button Content="?" Style="{StaticResource HelpButton}" Margin="8,0,0,4"
                        VerticalAlignment="Bottom"
                        controls:HelpBubble.Text="游戏视频录制与即时重放。支持硬件编码（Nvidia NVENC / Intel QSV / AMD VAAPI），热键控制，内存缓存重放。"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="游戏录制与即时重放（点 ? 看支持范围）。"/>
        </StackPanel>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 保存路径 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="保存路径" Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SavePathBox" Height="32" Margin="0,0,8,0"
                                     FontSize="12" Padding="6,0" VerticalContentAlignment="Center"
                                     TextWrapping="NoWrap"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Button Grid.Column="1" Content="📁 打开文件夹" Style="{StaticResource SecondaryButton}"
                                    Click="OpenFolder_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="录制文件将保存到此路径。点击「打开文件夹」可快速访问已录制的视频。"/>
                    </StackPanel>
                </Border>

                <!-- 录制设置 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="录制" Style="{StaticResource SectionTitle}"/>

                        <!-- 录制总开关（滑块，记住上次状态） -->
                        <CheckBox x:Name="RecordingEnabled" Style="{StaticResource ToggleSwitch}"
                                  Content="开启录制（打开后：按热键开始，再按热键结束）"
                                  Checked="RecordingEnabled_Toggled" Unchecked="RecordingEnabled_Toggled"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="关闭时录制热键不生效。"/>

                        <!-- 系统声音开关 -->
                        <CheckBox x:Name="SystemAudioBox" Content="录制系统声音（耳机/扬声器，含游戏声）"
                                  Style="{StaticResource RowCheckBox}"/>

                        <!-- 麦克风开关 -->
                        <CheckBox x:Name="MicrophoneEnabled" Content="录制麦克风音频"
                                  Style="{StaticResource RowCheckBox}"/>

                        <!-- 分辨率 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="分辨率" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="ResolutionBox" Width="140" Margin="10,0,0,0"
                                      FontSize="12" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="1280×720 (720p)" Tag="1280x720"/>
                                <ComboBoxItem Content="1920×1080 (1080p)" Tag="1920x1080"/>
                                <ComboBoxItem Content="2560×1440 (1440p)" Tag="2560x1440"/>
                                <ComboBoxItem Content="3840×2160 (4K)" Tag="3840x2160"/>
                                <ComboBoxItem Content="自定义..." Tag="custom"/>
                            </ComboBox>
                            <TextBox x:Name="CustomResolutionBox" Width="100" Height="26" Margin="8,0,0,0"
                                     FontSize="12" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- 帧率 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="帧率" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="FrameRateBox" Width="120" Margin="10,0,0,0"
                                      FontSize="12" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="30 FPS（推荐）" Tag="30"/>
                                <ComboBoxItem Content="60 FPS" Tag="60"/>
                                <ComboBoxItem Content="120 FPS" Tag="120"/>
                                <ComboBoxItem Content="144 FPS" Tag="144"/>
                                <ComboBoxItem Content="240 FPS" Tag="240"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 码率 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="码率" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="BitrateBox" Width="150" Margin="10,0,0,0"
                                      FontSize="12" VerticalContentAlignment="Center"
                                      SelectionChanged="BitrateBox_SelectionChanged">
                                <ComboBoxItem Content="15 Mbps（1080P 低 · 约 6.4 GB/时）" Tag="15000"/>
                                <ComboBoxItem Content="25 Mbps（1080P 高 / 2K 低 · 约 10.7 GB/时）" Tag="25000"/>
                                <ComboBoxItem Content="50 Mbps（4K 低 · 约 21.5 GB/时）" Tag="50000"/>
                                <ComboBoxItem Content="60 Mbps（2K 高 · 约 25.7 GB/时）" Tag="60000"/>
                                <ComboBoxItem Content="100 Mbps（4K 高 · 约 42.9 GB/时）" Tag="100000"/>
                                <ComboBoxItem Content="自定义..." Tag="custom"/>
                            </ComboBox>
                            <TextBox x:Name="CustomBitrateBox" Width="80" Height="26" Margin="8,0,0,0"
                                     FontSize="12" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock Text="Mbps" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>

                        <!-- 编码器 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="编码器" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="EncoderBox" Width="160" Margin="10,0,0,0"
                                      FontSize="12" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="自动检测（推荐）" Tag="auto"/>
                                <ComboBoxItem Content="Nvidia NVENC (h264_nvenc)" Tag="h264_nvenc"/>
                                <ComboBoxItem Content="Intel QSV (h264_qsv)" Tag="h264_qsv"/>
                                <ComboBoxItem Content="AMD VAAPI (h264_vaapi)" Tag="h264_vaapi"/>
                                <ComboBoxItem Content="AMD AMF (h264_amf)" Tag="h264_amf"/>
                                <ComboBoxItem Content="软件编码 (libx264)" Tag="libx264"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 封装格式 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="格式" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="ContainerBox" Width="120" Margin="10,0,0,0"
                                      FontSize="12" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="MP4（推荐）" Tag="mp4"/>
                                <ComboBoxItem Content="MKV" Tag="mkv"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 关键帧间隔 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="关键帧" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="KeyframeBox" Width="100" Margin="10,0,0,0"
                                      FontSize="12" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="1 秒" Tag="1"/>
                                <ComboBoxItem Content="2 秒（推荐）" Tag="2"/>
                                <ComboBoxItem Content="3 秒" Tag="3"/>
                                <ComboBoxItem Content="5 秒" Tag="5"/>
                                <ComboBoxItem Content="10 秒" Tag="10"/>
                            </ComboBox>
                            <TextBlock Text="秒" Style="{StaticResource UnitLabel}"/>
                        </StackPanel>

                        <!-- 音频参数 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="音频采样" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="AudioSampleRateBox" Width="100" Margin="10,0,0,0"
                                      FontSize="12" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="44100 Hz" Tag="44100"/>
                                <ComboBoxItem Content="48000 Hz" Tag="48000"/>
                                <ComboBoxItem Content="96000 Hz" Tag="96000"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="音频声道" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="AudioChannelsBox" Width="100" Margin="10,0,0,0"
                                      FontSize="12" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="立体声 (2)" Tag="2"/>
                                <ComboBoxItem Content="单声道 (1)" Tag="1"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="音频码率" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="AudioBitrateBox" Width="150" Margin="10,0,0,0"
                                      FontSize="12" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="0.064 Mbps" Tag="64"/>
                                <ComboBoxItem Content="0.128 Mbps（推荐）" Tag="128"/>
                                <ComboBoxItem Content="0.192 Mbps" Tag="192"/>
                                <ComboBoxItem Content="0.32 Mbps" Tag="320"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="编码器优先使用硬件加速（显卡/核显专用模块），不占用游戏性能。默认自动检测可用编码器。"/>
                    </StackPanel>
                </Border>

                <!-- 即时重放 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="即时重放" Style="{StaticResource SectionTitle}"/>

                        <!-- 即时重放总开关（滑块，记住上次状态） -->
                        <CheckBox x:Name="InstantReplayEnabled" Style="{StaticResource ToggleSwitch}"
                                  Content="开启即时重放（打开后：后台持续缓存，按热键保存一份回放录像）"
                                  Checked="InstantReplayEnabled_Toggled" Unchecked="InstantReplayEnabled_Toggled"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="关闭时即时重放热键不生效。热键不是开关，每次按下只保存一份回放，功能保持开启。"/>

                        <!-- 运行中锁：这些参数只在缓冲启动那一刻读取，运行中改了不生效 -->
                        <TextBlock x:Name="ReplayLockNote" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed"
                                   Text="即时重放正在运行：这些参数改了不会生效 —— 先关掉上面的开关再改，重新打开后会从 0 重新缓存。"/>

                        <StackPanel x:Name="ReplayParamsPanel">

                            <!-- 即时重放音频开关 -->
                            <CheckBox x:Name="ReplaySystemAudioBox" Content="录制即时重放系统声音（耳机/扬声器，含游戏声）"
                                      Style="{StaticResource RowCheckBox}"/>
                            <CheckBox x:Name="ReplayMicrophoneBox" Content="录制即时重放麦克风音频"
                                      Style="{StaticResource RowCheckBox}"/>

                            <!-- 最大重放时长（右侧秒数输入框与滑块双向联动） -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="最大时长" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="MaxReplayDurationSlider" Width="140" Margin="10,0,0,0"
                                        Minimum="5" Maximum="1800" Value="30"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="MaxReplayDurationSlider_ValueChanged"/>
                                <TextBlock x:Name="MaxReplayDurationText" Text="30 秒" FontSize="12"
                                           Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}"/>
                                <TextBox x:Name="MaxReplayDurationBox" Width="60" Height="26" Margin="10,0,0,0"
                                         FontSize="12" VerticalContentAlignment="Center" TextAlignment="Center"
                                         KeyDown="MaxReplayDurationBox_KeyDown"
                                         LostFocus="MaxReplayDurationBox_LostFocus"/>
                                <TextBlock Text="秒" Style="{StaticResource UnitLabel}"/>
                            </StackPanel>

                            <!-- 内存缓存：不设上限，只在备注里显示实际占用 -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="内存缓存" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="MemoryUsageText" FontSize="11" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}">
                                    不设上限（占用随「最大时长 × 重放码率」增长）
                                </TextBlock>
                            </StackPanel>

                            <!-- 重放帧率 -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="重放帧率" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="ReplayFrameRateBox" Width="120" Margin="10,0,0,0"
                                          FontSize="12" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="30 FPS（推荐）" Tag="30"/>
                                    <ComboBoxItem Content="60 FPS" Tag="60"/>
                                    <ComboBoxItem Content="120 FPS" Tag="120"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 即时重放分辨率 -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="重放分辨率" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="ReplayResolutionBox" Width="140" Margin="10,0,0,0"
                                          FontSize="12" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="1280×720 (720p)" Tag="1280x720"/>
                                    <ComboBoxItem Content="1920×1080 (1080p)" Tag="1920x1080"/>
                                    <ComboBoxItem Content="2560×1440 (1440p)" Tag="2560x1440"/>
                                    <ComboBoxItem Content="3840×2160 (4K)" Tag="3840x2160"/>
                                    <ComboBoxItem Content="自定义..." Tag="custom"/>
                                </ComboBox>
                                <TextBox x:Name="CustomReplayResolutionBox" Width="100" Height="26" Margin="8,0,0,0"
                                         FontSize="12" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- 即时重放码率 -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="重放码率" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="ReplayBitrateBox" Width="150" Margin="10,0,0,0"
                                          FontSize="12" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="15 Mbps（1080P 低 · 约 6.4 GB/时）" Tag="15000"/>
                                    <ComboBoxItem Content="25 Mbps（1080P 高 / 2K 低 · 约 10.7 GB/时）" Tag="25000"/>
                                    <ComboBoxItem Content="50 Mbps（4K 低 · 约 21.5 GB/时）" Tag="50000"/>
                                    <ComboBoxItem Content="60 Mbps（2K 高 · 约 25.7 GB/时）" Tag="60000"/>
                                    <ComboBoxItem Content="100 Mbps（4K 高 · 约 42.9 GB/时）" Tag="100000"/>
                                    <ComboBoxItem Content="自定义..." Tag="custom"/>
                                </ComboBox>
                                <TextBox x:Name="CustomReplayBitrateBox" Width="80" Height="26" Margin="8,0,0,0"
                                         FontSize="12" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock Text="Mbps" Style="{StaticResource UnitLabel}"/>
                            </StackPanel>

                        </StackPanel>   <!-- /ReplayParamsPanel（运行中整块禁用） -->

                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="画质与体积参考、以及即时重放的工作方式，见下方 ? 说明。"/>

                        <!-- 回放缓存与时长（实时） -->
                        <Border Margin="0,10,0,0" Padding="10" CornerRadius="4"
                                Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="回放缓存与时长" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" VerticalAlignment="Center"/>
                                    <Button Content="?" Style="{StaticResource HelpButton}" Margin="6,0,0,4"
                                            controls:HelpBubble.Text="码率分档（按分辨率）：1080P 低 15 / 高 25 Mbps；2K 低 25 / 高 60 Mbps；4K 低 50 / 高 100 Mbps。整局录像搭在即时重放这一路采集上，所以这里的重放分辨率/帧率/码率就是录像画质（录制那一组只在重放没开时才用）。一局约 18 分钟：2K 高（60 Mbps）约 7.7 GB、2K 低（25 Mbps）约 3.2 GB。OBS 式方案：后台把画面用显卡硬件编码成 H.264 流（含系统声音/麦克风），滚动缓存在内存里，保存片段时不重新编码、只转封装，速度很快。缓冲占用内存，大小 = 码率 ÷ 8，与硬盘容量无关；硬盘只在保存片段时写一次文件。"/>
                                </StackPanel>
                                <TextBlock x:Name="MemoryUsageDetailText" FontSize="11"
                                           Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap">
                                    当前占用：0 MB（不设上限）
                                </TextBlock>
                                <TextBlock x:Name="BufferCapacityText" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap">
                                    需要缓存：—
                                </TextBlock>
                                <TextBlock x:Name="MemoryAdviceText" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap">
                                    —
                                </TextBlock>
                                <TextBlock x:Name="MemoryHintText" FontSize="11" Margin="0,6,0,0"
                                           Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"
                                           Text="缓冲占用内存，与硬盘容量无关。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 热键绑定 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="热键绑定" Style="{StaticResource SectionTitle}"/>

                        <!-- 录制热键：与其它模块卡片统一 —— 复选框 + 只读热键框，点框即开始绑定 -->
                        <CheckBox x:Name="RecordHotkeyEnabled" Content="启用录制热键"
                                  Style="{StaticResource RowCheckBox}" Margin="0,0,0,6"/>
                        <TextBox x:Name="RecordHotkeyBox" Height="32" FontSize="12"
                                 Padding="6,0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                 PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"/>

                        <!-- 即时重放热键 -->
                        <CheckBox x:Name="ReplayHotkeyEnabled" Content="启用即时重放热键"
                                  Style="{StaticResource RowCheckBox}" Margin="0,14,0,6"/>
                        <TextBox x:Name="ReplayHotkeyBox" Height="32" FontSize="12"
                                 Padding="6,0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                 PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"/>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="点击「绑定热键」后直接按下组合键即可录制/重放。热键在工具箱运行时全局生效（可最小化）。"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
