<Window x:Class="GameHub.Modules.AudioPlaybackConnector.AudioPlaybackConnectorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameHub.Controls"
        Title="AudioPlaybackConnector · 蓝牙音频接收" Height="560" Width="560"
        MinHeight="420" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <ResourceDictionary>
            <!-- 主题由 App.xaml 在应用级合并（Themes/PaviseDark.xaml）；此处不再重复合并，
                 否则会复制第二份画刷实例，运行时换肤时本窗口不会被更新。 -->

            <ControlTemplate x:Key="RoundedButton" TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                        Padding="{TemplateBinding Padding}" BorderThickness="0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- 设备列表：BasedOn 主题隐式样式，否则会顶掉深色底与浅色文字 -->
            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="蓝牙音频接收" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource FgBrush}"/>
            <TextBlock Text="让电脑作为蓝牙音箱接收手机等设备的音频（A2DP Sink）"
                       Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="已配对的蓝牙音频设备" Style="{StaticResource SectionTitle}"/>
                            <Button Content="?" Style="{StaticResource HelpButton}" Margin="6,0,0,10"
                                    controls:HelpBubble.Text="提示：需要先在系统蓝牙设置里配对好手机/平板，这里才能看到设备。连接时请让手机保持在电脑附近并已开启蓝牙（最长等待 30 秒）；双击列表项即可连接。若同一台设备有多条配对记录，列表会用 [MAC] 区分，连接失败时会自动尝试另一条。"/>
                        </StackPanel>
                        <ListBox x:Name="DeviceList" Height="200"
                                 MouseDoubleClick="DeviceList_MouseDoubleClick"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="连接" Style="{StaticResource PrimaryButton}"
                                    Click="Connect_Click"/>
                            <Button Content="断开" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="Disconnect_Click"/>
                            <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="Refresh_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="状态" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="StatusText" Text="正在检测…" FontSize="12"
                                   Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="打开系统蓝牙设置" Style="{StaticResource SecondaryButton}"
                                    Click="OpenBluetoothSettings_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="连接前请先在系统蓝牙设置里配对好设备（点上方 ? 看细节）。"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="热键设置" Style="{StaticResource SectionTitle}"/>
                            <Button Content="?" Style="{StaticResource HelpButton}" Margin="6,0,0,10"
                                    controls:HelpBubble.Text="按下热键可暂停/恢复蓝牙音频传输（手机声音不从电脑输出 / 从电脑输出）。暂停只静音手机的蓝牙音频流，电脑上其它声音不受影响，手机与电脑的连接保持不断；关闭程序时会自动取消静音。热键在工具箱运行时全局生效（可最小化）。"/>
                        </StackPanel>
                        <CheckBox x:Name="BluetoothAudioPauseHotkeyEnabled" Content="启用蓝牙音频暂停/恢复热键"
                                  FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="BluetoothAudioPauseHotkeyBox" Height="32" FontSize="12"
                                 Padding="6,0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="用热键暂停 / 恢复手机音频到电脑的输出。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
