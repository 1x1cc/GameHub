<Window x:Class="GameHub.Modules.AudioPlaybackConnector.AudioPlaybackConnectorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioPlaybackConnector · 蓝牙音频接收" Height="560" Width="560"
        MinHeight="420" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <ControlTemplate x:Key="RoundedButton" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}" BorderThickness="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4A90D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E3E9F0"/>
            <Setter Property="Foreground" Value="#33475B"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#22303F"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8896A6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#DCE3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="蓝牙音频接收" FontSize="20" FontWeight="Bold" Foreground="#22303F"/>
            <TextBlock Text="让电脑作为蓝牙音箱接收手机等设备的音频（A2DP Sink）"
                       Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="已配对的蓝牙音频设备" Style="{StaticResource SectionTitle}"/>
                        <ListBox x:Name="DeviceList" Height="200"
                                 MouseDoubleClick="DeviceList_MouseDoubleClick"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="连接" Style="{StaticResource PrimaryButton}"
                                    Click="Connect_Click"/>
                            <Button Content="断开" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="Disconnect_Click"/>
                            <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="Refresh_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="状态" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="StatusText" Text="正在检测…" FontSize="12"
                                   Foreground="#33475B" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="打开系统蓝牙设置" Style="{StaticResource SecondaryButton}"
                                    Click="OpenBluetoothSettings_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="提示：需要先在系统蓝牙设置里配对好手机/平板，这里才能看到设备。连接时请让手机保持在电脑附近并已开启蓝牙（最长等待 30 秒）；双击列表项即可连接。若同一台设备有多条配对记录，列表会用 [MAC] 区分，连接失败时会自动尝试另一条。"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="热键设置" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="BluetoothAudioPauseHotkeyEnabled" Content="启用蓝牙音频暂停/恢复热键"
                                  FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="BluetoothAudioPauseHotkeyBox" Height="28" FontSize="12"
                                 IsReadOnly="True" VerticalContentAlignment="Center"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="按下热键可暂停/恢复蓝牙音频传输（手机声音不从电脑输出 / 从电脑输出）。暂停只静音手机的蓝牙音频流，电脑上其它声音不受影响，手机与电脑的连接保持不断；关闭程序时会自动取消静音。热键在工具箱运行时全局生效（可最小化）。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
