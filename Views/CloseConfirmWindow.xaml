<Window x:Class="GameHub.Views.CloseConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭 GameHub" Width="430" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F7FA"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <ControlTemplate x:Key="RoundedButton" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}" BorderThickness="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E3E9F0"/>
            <Setter Property="Foreground" Value="#33475B"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
        </Style>

        <!-- 两个关闭方式：Content = 标题，Tag = 说明文字 -->
        <Style x:Key="ChoiceButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#DCE3EC" BorderThickness="1"
                                CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#22303F"/>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="11" Foreground="#8896A6"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF2FC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A90D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D8E8F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8896A6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="要关闭 GameHub 吗？" FontSize="16" FontWeight="SemiBold" Foreground="#22303F"/>
        <TextBlock Text="请选择关闭方式。关掉窗口后，需要热键继续生效就选「最小化到托盘」。"
                   Style="{StaticResource Hint}" Margin="0,6,0,0"/>

        <Button x:Name="ExitChoice" Content="完全退出软件" Margin="0,16,0,8"
                Tag="结束所有功能，全局热键立即失效，托盘图标一并消失"
                Style="{StaticResource ChoiceButton}" Click="ExitChoice_Click"/>

        <Button x:Name="TrayChoice" Content="最小化到托盘" Margin="0,0,0,0"
                Tag="程序在后台继续运行，全局热键仍然生效；双击托盘图标可恢复主界面"
                Style="{StaticResource ChoiceButton}" Click="TrayChoice_Click"/>

        <CheckBox x:Name="RememberCheck" Content="记住我的选择，下次不再询问"
                  FontSize="12" Margin="2,14,0,0" ToolTip="勾选后按上面所选方式直接关闭；可随时在「软件设置」中更改"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
