<Window x:Class="GameHub.Views.HubSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameHub · 软件设置" Height="460" Width="520"
        MinHeight="380" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <ControlTemplate x:Key="RoundedButton" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}" BorderThickness="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4A90D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E3E9F0"/>
            <Setter Property="Foreground" Value="#33475B"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#22303F"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8896A6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Option" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#22303F"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="软件设置" FontSize="20" FontWeight="Bold" Foreground="#22303F"/>
            <TextBlock Text="这里的设置对 GameHub 整体生效" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="关闭窗口时" Style="{StaticResource SectionTitle}"/>

                        <RadioButton x:Name="AskRadio" GroupName="CloseBehavior" Style="{StaticResource Option}"
                                     Content="每次询问：弹出对话框让我选择"/>
                        <RadioButton x:Name="ExitRadio" GroupName="CloseBehavior" Style="{StaticResource Option}"
                                     Content="完全退出软件：结束所有功能，全局热键失效"/>
                        <RadioButton x:Name="TrayRadio" GroupName="CloseBehavior" Style="{StaticResource Option}"
                                     Content="最小化到系统托盘：后台继续运行，全局热键仍然生效"/>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="选择「每次询问」时，点关闭会弹出选择框；在框里勾选「记住我的选择」即不再询问，之后可随时回到这里更改。最小化到托盘后，双击托盘图标即可恢复主界面。"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存并应用" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
