<Window x:Class="GameHub.Views.HubSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameHub.Controls"
        Title="GameHub · 软件设置" Height="640" Width="560"
        MinHeight="420" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <ResourceDictionary>
            <!-- 主题由 App.xaml 在应用级合并（Themes/PaviseDark.xaml）；此处不再重复合并，
                 否则会复制第二份画刷实例，运行时换肤时本窗口不会被更新。 -->

            <ControlTemplate x:Key="RoundedButton" TargetType="Button">
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                        Padding="{TemplateBinding Padding}" BorderThickness="0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="Option" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- 热键绑定卡片：行样式 -->
            <Style x:Key="HotkeyLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="HotkeyToggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="8,0,10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="170"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ToolTip" Value="点入后按下要绑定的组合键（例如 Ctrl+Alt+F9）"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="软件设置" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource FgBrush}"/>
            <TextBlock Text="这里的设置对 GameHub 整体生效" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="关闭窗口时" Style="{StaticResource SectionTitle}"/>
                            <Button Content="?" Style="{StaticResource HelpButton}" Margin="6,0,0,10"
                                    controls:HelpBubble.Text="选择「每次询问」时，点关闭会弹出选择框；在框里勾选「记住我的选择」即不再询问，之后可随时回到这里更改。最小化到托盘后，双击托盘图标即可恢复主界面。"/>
                        </StackPanel>

                        <RadioButton x:Name="AskRadio" GroupName="CloseBehavior" Style="{StaticResource Option}"
                                     Content="每次询问：弹出对话框让我选择"/>
                        <RadioButton x:Name="ExitRadio" GroupName="CloseBehavior" Style="{StaticResource Option}"
                                     Content="完全退出软件：结束所有功能，全局热键失效"/>
                        <RadioButton x:Name="TrayRadio" GroupName="CloseBehavior" Style="{StaticResource Option}"
                                     Content="最小化到系统托盘：后台继续运行，全局热键仍然生效"/>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="关闭主窗口时按哪种方式处理。"/>
                    </StackPanel>
                </Border>

                <!-- 外观：白天 / 黑夜 + 主题色（参考 Pavise，改完立即生效） -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>
                            <Button Content="?" Style="{StaticResource HelpButton}" Margin="6,0,0,10"
                                    controls:HelpBubble.Text="切换后立即生效（含已打开的窗口与标题栏），无需重启。配色与 Pavise 一致：背景、卡片、描边与文字会随明暗整体切换；主题色用于按钮与选中态，点菱形色块即换色。"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LightRadio" GroupName="ThemeMode" Style="{StaticResource Option}"
                                         Margin="0,0,18,0" Content="白天模式"
                                         Checked="ThemeMode_Checked"/>
                            <RadioButton x:Name="DarkRadio" GroupName="ThemeMode" Style="{StaticResource Option}"
                                         Content="黑夜模式（默认）"
                                         Checked="ThemeMode_Checked"/>
                        </StackPanel>

                        <!-- 主题色：菱形色块，点一下即切换（参照 Pavise 的色块选色） -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="主题色" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DimBrush}"/>
                            <StackPanel x:Name="AccentSwatchHost" Orientation="Horizontal"
                                        Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="明暗模式与主题色，改完立即生效。"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="开机自启动" Style="{StaticResource SectionTitle}"/>
                            <Button Content="?" Style="{StaticResource HelpButton}" Margin="6,0,0,10"
                                    controls:HelpBubble.Text="开启后，登录 Windows 时 GameHub 会在后台启动：只显示托盘图标、热键立即可用，双击托盘图标就能打开主界面。取消勾选则自启动时和手动打开一样直接显示主窗口。手动打开程序不受此项影响。"/>
                        </StackPanel>

                        <CheckBox x:Name="AutoStartTrayCheck" FontSize="12" Foreground="{DynamicResource FgBrush}"
                                  Content="开机自启动后最小化到托盘运行（不弹出主窗口）"/>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="登录 Windows 时是否自动在后台启动。"/>
                    </StackPanel>
                </Border>

                <!-- Pavise：由 GameHub 托管的后台性能工具 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pavise（后台性能）" Style="{StaticResource SectionTitle}"/>
                            <Button Content="?" Style="{StaticResource HelpButton}" Margin="6,0,0,10"
                                    controls:HelpBubble.Text="Pavise 由 GameHub 统一管理：GameHub 启动时把它拉起来并在后台隐藏运行，GameHub 退出时收掉它。桌面与托盘都只有 GameHub 一个入口，点卡片上的「打开」即可唤出 Pavise 面板（面板关闭 = 隐藏，再点卡片立刻唤回）。开机自启动只需开启上面那项，Pavise 会随 GameHub 一起启动。"/>
                        </StackPanel>

                        <CheckBox x:Name="PaviseStartWithHubCheck" FontSize="12" Foreground="{DynamicResource FgBrush}"
                                  Content="随 GameHub 一起启动 Pavise（隐藏运行，不显示托盘图标）"/>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Pavise 由 GameHub 拉起并统一收尾，点卡片即可唤出面板。"/>
                    </StackPanel>
                </Border>

                <!-- 热键绑定：集中显示并修改所有模块的热键 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="热键绑定" Style="{StaticResource SectionTitle}"/>
                            <Button Content="?" Style="{StaticResource HelpButton}" Margin="6,0,0,10"
                                    controls:HelpBubble.Text="这里集中显示并修改所有模块的热键。点入输入框后直接按下想要的组合键即可重新绑定；保存后立即全局生效，各模块卡片里的热键设置会同步更新。若两个热键重复，保存时会标红并报错，无法保存。"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="集中管理所有模块的热键，点入输入框直接按组合键即可重绑。"/>

                        <!-- 输出设备切换 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="输出设备切换（SoundSwitch）" Style="{StaticResource HotkeyLabel}"/>
                            <CheckBox x:Name="PlaybackHotkeyEnabled" Grid.Column="1" Content="启用" Style="{StaticResource HotkeyToggle}"/>
                            <TextBox x:Name="PlaybackHotkeyBox" Grid.Column="2" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>

                        <!-- 输入设备切换 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="输入设备切换（SoundSwitch）" Style="{StaticResource HotkeyLabel}"/>
                            <CheckBox x:Name="RecordingHotkeyEnabled" Grid.Column="1" Content="启用" Style="{StaticResource HotkeyToggle}"/>
                            <TextBox x:Name="RecordingHotkeyBox" Grid.Column="2" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>

                        <!-- 蓝牙音频暂停 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="蓝牙音频暂停/恢复（蓝牙音频接收）" Style="{StaticResource HotkeyLabel}"/>
                            <CheckBox x:Name="BluetoothHotkeyEnabled" Grid.Column="1" Content="启用" Style="{StaticResource HotkeyToggle}"/>
                            <TextBox x:Name="BluetoothHotkeyBox" Grid.Column="2" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>

                        <!-- Dronesee 录制 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="录制开/关（Dronesee）" Style="{StaticResource HotkeyLabel}"/>
                            <CheckBox x:Name="RecordHotkeyEnabled" Grid.Column="1" Content="启用" Style="{StaticResource HotkeyToggle}"/>
                            <TextBox x:Name="RecordHotkeyBox" Grid.Column="2" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>

                        <!-- Dronesee 即时重放 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="保存即时重放（Dronesee）" Style="{StaticResource HotkeyLabel}"/>
                            <CheckBox x:Name="ReplayHotkeyEnabled" Grid.Column="1" Content="启用" Style="{StaticResource HotkeyToggle}"/>
                            <TextBox x:Name="ReplayHotkeyBox" Grid.Column="2" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        </Grid>

                        <TextBlock x:Name="HotkeyErrorText" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- 悬浮窗：各模块的悬浮窗设置集中在这里（控件由代码生成，见 BuildFloatingSection） -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="悬浮窗" Style="{StaticResource SectionTitle}"/>
                            <Button Content="?" Style="{StaticResource HelpButton}" Margin="6,0,0,10"
                                    controls:HelpBubble.Text="这里集中管理各模块的悬浮窗：显示、锁定移动、始终置顶、鼠标穿透、不透明度。与各模块自己的设置页共用同一份配置，改哪边都一样；改完最多 1.5 秒生效，不需要重启。"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="集中管理各模块悬浮窗的显示与外观。"/>
                        <StackPanel x:Name="FloatingHost" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="保存并应用" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
