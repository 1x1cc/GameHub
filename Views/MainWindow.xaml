<Window x:Class="GameHub.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameHub.ViewModels"
        xmlns:controls="clr-namespace:GameHub.Controls"
        Title="GameHub" Height="700" Width="820"
        MinHeight="450" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        WindowState="Normal"
        AllowDrop="False"
        Icon="pack://application:,,,/Assets/Icons/gamehub.png">
    <Window.Resources>
        <ResourceDictionary>
            <!-- 主题由 App.xaml 在应用级合并（Themes/PaviseDark.xaml）；此处不再重复合并，
                 否则会复制第二份画刷实例，运行时换肤时本窗口不会被更新。 -->

            <!-- 卡片样式 -->
            <Style x:Key="ModuleCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Margin" Value="8"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="#FF000000"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <!-- 圆角按钮模板 -->
            <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
                <Border x:Name="border" Background="{TemplateBinding Background}"
                        CornerRadius="6" Padding="{TemplateBinding Padding}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <ControlTemplate x:Key="AutoStartButtonTemplate" TargetType="Button">
                <Border x:Name="border" Background="{TemplateBinding Background}"
                        CornerRadius="6" Padding="{TemplateBinding Padding}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- 按钮样式 -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}"/>
            </Style>

            <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            </Style>

            <Style x:Key="AutoStartButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource TrackOffBrush}"/>
                <Setter Property="Template" Value="{StaticResource AutoStartButtonTemplate}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAutoStartEnabled}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 圆形滑块总开关：只出现在支持总开关的卡片上（如 GlassBoard） -->
            <BooleanToVisibilityConverter x:Key="SwitchVisibility"/>

            <Style TargetType="{x:Type controls:ToggleSlider}">
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="OnBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="OffBrush" Value="{DynamicResource TrackOffBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:ToggleSlider}">
                            <Grid Background="Transparent">
                                <Border x:Name="PART_Track" CornerRadius="13"
                                        Background="{TemplateBinding OffBrush}"/>
                                <Border x:Name="PART_Thumb" Width="20" Height="20" CornerRadius="10"
                                        Margin="3,0,0,0" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Background="#FFFFFFFF">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.28" Color="#000000"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Padding="16,12" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 应用图标和名称 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/Icons/gamehub.png" Width="28" Height="28" Margin="0,0,8,0"/>
                    <TextBlock Text="GameHub" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource FgBrush}"/>
                </StackPanel>

                <!-- 工具箱自启动 + 刷新 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 第 6 条：昼夜切换按钮（太阳 ⟷ 月亮，点击时图标旋转 + 配色以按钮为圆心扩散） -->
                    <Button x:Name="ThemeToggleButton" Width="30" Height="30" Margin="0,0,8,0"
                            Style="{StaticResource GhostButtonStyle}" Padding="0"
                            ToolTip="切换白天 / 黑夜模式" Click="ThemeToggle_Click">
                        <TextBlock x:Name="ThemeIcon" Text="☀" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="ThemeIconRotation"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button x:Name="HubAutoStartButton" Height="30" MinWidth="130"
                            Style="{StaticResource AutoStartButtonStyle}"
                            Click="HubAutoStart_Click"/>
                    <Button Content="设置" Width="70" Height="30" Margin="8,0,0,0"
                            Style="{StaticResource GhostButtonStyle}" Click="Settings_Click"/>
                    <Button Content="刷新" Width="70" Height="30" Margin="8,0,0,0"
                            Style="{StaticResource GhostButtonStyle}" Click="Refresh_Click"/>
                    <Button Content="报错/日志" Width="92" Height="30" Margin="8,0,0,0"
                            Style="{StaticResource GhostButtonStyle}" Click="CrashReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 模块卡片网格：UniformGrid 2 列，卡片平分宽度 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="8,4">
            <ItemsControl x:Name="ModulesList" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModuleCardViewModel}">
                        <Border Style="{StaticResource ModuleCardStyle}"
                                MouseLeftButtonDown="ModuleCard_Click" Cursor="Hand">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                             To="0.7" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                             To="0.45" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <!-- 内层卡片：16 圆角 + 4px 填充，与外层构成 20/16/4 规范 -->
                            <Border CornerRadius="16" Background="{DynamicResource BgBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}"
                                    Padding="14">
                            <Grid>
                                <!-- 两列布局：第 0 列只放图标，第 1 列放全部文字与操作。 -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 图标 -->
                                <Image Grid.Row="0" Grid.Column="0" Source="{Binding IconSource}"
                                       Width="44" Height="44" Margin="0,0,12,0"
                                       Stretch="Uniform" VerticalAlignment="Center"/>

                                <!-- 名称 + 状态 -->
                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                            Margin="0,0,0,8">
                                    <TextBlock Text="{Binding ModuleName}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                               Foreground="{DynamicResource DimBrush}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- 描述：与名称同一条左边线 -->
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Description}"
                                           FontSize="12" Foreground="{DynamicResource DimBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <!-- 分隔线：横跨整张卡片 -->
                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,0,0,12"/>

                                <!-- 操作区：打开按钮 + 圆形总开关 -->
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="打开" Style="{StaticResource ActionButtonStyle}"
                                            Command="{Binding OpenPanelCommand}"
                                            Margin="0,0,12,0"
                                            Visibility="{Binding ShowOpenButton, Converter={StaticResource SwitchVisibility}}"/>
                                    <controls:ToggleSlider IsChecked="{Binding IsModuleEnabled, Mode=TwoWay}"
                                                           ToolTip="{Binding SwitchToolTip}"
                                                           Visibility="{Binding SupportsSwitch, Converter={StaticResource SwitchVisibility}}"/>
                                </StackPanel>
                            </Grid>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Padding="12,6" Background="Transparent"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="GameHub v1.1.0 · 音频 · 蓝牙 · 电量 · 录制 · 性能 · 美化" FontSize="10"
                       Foreground="{DynamicResource FaintBrush}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
