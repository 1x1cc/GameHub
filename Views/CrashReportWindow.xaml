<Window x:Class="GameHub.Views.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameHub · 诊断报告 / 报错" Height="580" Width="760"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <ControlTemplate x:Key="RoundedButton" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}" BorderThickness="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4A90D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E3E9F0"/>
            <Setter Property="Foreground" Value="#33475B"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButton}"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8896A6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="诊断报告 / 报错" FontSize="20" FontWeight="Bold" Foreground="#22303F"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="下面的内容包含系统信息、音频设备、热键设置和最近日志（不含个人隐私）。把内容发给开发者，能帮助你快速定位「切换设备后热键没反应」这类问题。"/>
        </StackPanel>

        <!-- 报告内容 -->
        <TextBox x:Name="ReportBox" Grid.Row="1"
                 IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="重新生成" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/>
            <Button Content="复制到剪贴板" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Copy_Click"/>
            <Button Content="导出文件并打开目录" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Export_Click"/>
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>